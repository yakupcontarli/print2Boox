{
  "name": "Print to Boox",
  "version": "0.0.9",
  "description": "Print any page or send URL to Boox reader (via boox push service)",
  "options_page": "options.html",
  "default_locale": "en_GB",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.boox.com/*",
        "*://*.send2boox.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Print to Boox",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "printerProvider",
    "notifications",
    "storage",
    "webRequest",
    "scripting",
    "tabs",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.send2boox.com/*",
    "*://*.boox.com/*",
    "*://*.aliyuncs.com/*"
  ],
  "manifest_version": 3
}
